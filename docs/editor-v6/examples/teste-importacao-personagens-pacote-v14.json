  "lines": [
    {
      "character": "hino",
      "kind": "thought",
      "text": "Ela parece muito mais confiante nessa versão.",
      "startSeconds": 5,
      "durationSeconds": 3.6
    },
    {
      "character": "test",
      "kind": "speech",
      "text": "A mudança é bem clara.",
      "startSeconds": 8.9,
      "durationSeconds": 3.2
    },
    {
      "character": "La ele",
      "kind": "thought",
      "text": "Então o futuro realmente mudou alguma coisa nela.",
      "startSeconds": 12.4,
      "durationSeconds": 4.3
    },
    {
      "character": "oooul",
      "kind": "speech",
      "text": "Os guardas obedeceram na mesma hora.",
      "startSeconds": 26.1,
      "durationSeconds": 3.2
    },
    {
      "character": "hino",
      "kind": "thought",
      "text": "Parece que ela ganhou bastante autoridade.",
      "startSeconds": 29.6,
      "durationSeconds": 3.6
    },
    {
      "character": "test",
      "kind": "thought",
      "text": "Quero saber o que esse homem fez antes disso.",
      "startSeconds": 33.5,
      "durationSeconds": 4.3
    },
    {
      "character": "La ele",
      "kind": "speech",
      "text": "Eles se esbarraram e ficaram se olhando.",
      "startSeconds": 45.3,
      "durationSeconds": 3.2
    },
    {
      "character": "oooul",
      "kind": "thought",
      "text": "Isso parece o começo de alguma coisa.",
      "startSeconds": 48.8,
      "durationSeconds": 3.6
    },
    {
      "character": "hino",
      "kind": "speech",
      "text": "Agora fiquei curioso para ver o próximo.",
      "startSeconds": 52.7,
      "durationSeconds": 3.2
    },
    {
      "character": "test",
      "kind": "thought",
      "text": "A edição está deixando esse romance bem óbvio.",
      "startSeconds": 68.3,
      "durationSeconds": 4.3
    },
    {
      "character": "La ele",
      "kind": "speech",
      "text": "Então aquele encontro realmente tinha importância.",
      "startSeconds": 72.9,
      "durationSeconds": 3.2
    },
    {
      "character": "oooul",
      "kind": "thought",
      "text": "Pelo menos os dois parecem felizes juntos.",
      "startSeconds": 76.4,
      "durationSeconds": 3.6
    }
  ],
