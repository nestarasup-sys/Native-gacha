    "node": ">=22.22.0"
  },
  "build": {
    "appId": "com.gachanymi.workapp",
    "productName": "Gacha Nymi",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/video-tools",
        "to": "video-tools",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "FFMPEG_LICENSE.txt",
          "BUILD_INFO.json",
          "SOURCE_INFO.txt"
        ]
      },
      {
        "from": "out/native/editor-v6-renderer/Release",
        "to": "native",
        "filter": [
          "editor-v6-native-renderer.exe"
        ]
      }
    ]
  }
}
